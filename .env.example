# Copy to .env.local for local dev. On Vercel, set these in Project Settings > Environment Variables.
# Never commit real values. Test-mode keys only.

# Demo account (server-side only; never sent to the browser)
MH_STAGING_API_KEY=
MH_PRODUCTION_API_KEY=

# Demo account public keys for the JS SDK flows (public by design; used when none is typed in Config)
MH_STAGING_PUBLIC_KEY=
MH_PRODUCTION_PUBLIC_KEY=

# Webhook signing keys, used to verify MoneyHash-Signature v3 (optional)
MH_STAGING_WEBHOOK_SIGNING_KEY=
MH_PRODUCTION_WEBHOOK_SIGNING_KEY=

# Live-mode keys are allowed (the console flags LIVE MODE). Set to "true" to refuse them,
# e.g. on a public deployment.
MH_BLOCK_LIVE_KEYS=

# Order/webhook storage on Vercel (instances don't share memory): a private Vercel Blob
# store. Set automatically when the store is connected to the project; empty = memory (local dev).
BLOB_READ_WRITE_TOKEN=
